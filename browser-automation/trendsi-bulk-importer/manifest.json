{
  "manifest_version": 3,
  "name": "PrimeStyleAI Trendsi Bulk Importer",
  "version": "0.5.4",
  "description": "Coordinates two Women and two Men workers, skips Shopify-marked products, and imports only missing Trendsi items above 50 inventory as drafts.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.trendsi.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.trendsi.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PrimeStyleAI Trendsi Bulk Importer"
  }
}
